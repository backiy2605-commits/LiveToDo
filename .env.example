# ==========================================
# LiveToDo – Environment Variables for Vercel
# ==========================================

# 1. MongoDB Atlas Connection URI (Free tier from mongodb.com)
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/livetodo?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/livetodo?retryWrites=true&w=majority

# 2. Google OAuth Web Client ID (from console.cloud.google.com)
# Example: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 3. JWT Secret for user session signing (any random string)
JWT_SECRET=livetodo-super-secret-key-change-this-in-production
